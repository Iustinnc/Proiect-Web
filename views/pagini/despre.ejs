<!DOCTYPE html>
<html lang="ro">

<head>
    <%- include('../fragmente/head') %>
</head>

<body>
    <%- include('../fragmente/header') %>

    <main style="padding: 40px 20px; max-width: 1200px; margin: 0 auto; min-height: 60vh;">
        <h1 style="color: var(--primary-color); text-align: center; margin-bottom: 30px;">Povestea CarSW</h1>
        
        <section style="display: flex; flex-wrap: wrap; gap: 30px; align-items: center;">
            <div style="flex: 1; min-width: 300px;">
                <p style="font-size: 1.2rem; line-height: 1.6; margin-bottom: 15px;">
                    Proiectul <strong>CarSW</strong> a pornit din pasiunea pentru automobile și din dorința de a oferi utilizatorilor o platformă transparentă și ușor de folosit pentru recenzii și oferte auto.
                </p>
                <p style="font-size: 1.2rem; line-height: 1.6; margin-bottom: 15px;">
                    Fie că ești în căutarea primului tău vehicul sau dorești un upgrade la o mașină de lux, echipa noastră se asigură că ai la dispoziție cele mai bune informații tehnice și oferte de pe piață.
                </p>
                <ul style="font-size: 1.1rem; line-height: 1.6; padding-left: 20px;">
                    <li>🚗 Peste 500 de modele recenzate</li>
                    <li>🤝 Parteneriate cu dealeri auto de top</li>
                    <li>🔧 Sfaturi de mentenanță și consultanță gratuită</li>
                </ul>
            </div>
            
            
            <div style="flex: 1; min-width: 300px; text-align: center;">
                <img src="/resurse/imagini/favicon/web-app-manifest-192x192.png" alt="Echipa CarSW" style="max-width: 100%; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            </div>
        </section>
    </main>

    <%- include('../fragmente/footer') %>
</body>
</html>